# Copie este arquivo para ".env" e preencha os valores. O ".env" nunca vai para o Git.
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env

# Usuário Linux usado dentro dos contêineres.
# No Linux, rode `id -u` e use o resultado. No Windows e no macOS, deixe 50000.
AIRFLOW_UID=50000

# Login do administrador da interface do Airflow (criado na primeira subida).
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=troque-esta-senha

# Banco de dados do pipeline (o Postgres que guarda a tabela geracao_diaria).
# Evite na senha os caracteres @ : / ? # %, pois ela entra numa URL logo abaixo.
PIPELINE_POSTGRES_USER=pipeline
PIPELINE_POSTGRES_DB=pipeline
PIPELINE_POSTGRES_PASSWORD=troque-esta-senha

# Connection "pipeline_db" lida pelas tasks. Use os mesmos valores acima:
#   postgresql://USUARIO:SENHA@postgres-pipeline:5432/BANCO
# O host é o NOME DO SERVIÇO no Compose (postgres-pipeline), não "localhost",
# e a porta é a interna (5432), não a publicada no seu computador (5433).
AIRFLOW_CONN_PIPELINE_DB=postgresql://pipeline:troque-esta-senha@postgres-pipeline:5432/pipeline

# Chave Fernet: criptografa senhas de conexões guardadas pelo Airflow.
# Precisa ter 44 caracteres e terminar com "=". Gere uma com o comando abaixo
# e cole o resultado, sem remover o "=" do final:
#   docker run --rm apache/airflow:3.3.1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
